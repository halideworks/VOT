; VOT v0.3 proof and data-record schemas.
; RFC 8949 core deterministic encoding is mandatory in addition to CDDL.

proof-bundle = {
  0: 0,                         ; bundle format version
  1: id128,                     ; request_id
  2: id128,                     ; bundle_id
  3: object-id,
  4: uint .le 9223372036854775807, ; requested_offset
  5: uint .le 4194304,          ; requested_length
  6: uint .le 9223372036854775807, ; covered_offset, 64 KiB aligned
  7: uint .le 4259840,          ; covered_length, request plus edge groups
  8: uint .le 17,               ; data_record_count
  9: uint .le 4259840,          ; total_plaintext_length
  10: bstr .size (0..16777216), ; suite proof bytes
}

data-record = {
  0: 0,                         ; data record format version
  1: id128,                     ; bundle_id
  2: uint .le 16,               ; record_index
  3: uint .le 9223372036854775807, ; plaintext_offset
  4: uint .le 262144,           ; plaintext_length
  5: compression-suite,
  6: uint .le 262144,           ; encoded_length
  7: bstr .size (0..262144),    ; exactly encoded_length bytes
}

object-id = [
  suite-id,
  bstr .size 32,
  uint .le 9223372036854775807,
]

suite-id = 1 / 2
compression-suite = 0 / 1
id128 = bstr .size 16
