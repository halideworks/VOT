{
  "format": "vot-wire-negotiation-v1",
  "alpn": "vot-draft-05",
  "draft_revision": 5,
  "max_extensions_per_hello": 256,
  "max_settings_per_frame": 128,
  "note": "HELLO and SETTINGS payloads as spec/wire.md section 1 defines them. Payload bytes only; the frame envelope is covered by frame-envelope.json. Encoders must match every canonical case byte for byte. Extensions are written in ascending identifier order so one HELLO has exactly one encoding.",
  "settings_registry": [
    {
      "id": 1,
      "name": "MAX_CONTROL_FRAME_PAYLOAD",
      "min": 1024,
      "max": 16777216,
      "default": 1048576
    },
    {
      "id": 3,
      "name": "MAX_DATA_RECORD_PAYLOAD",
      "min": 65536,
      "max": 262144,
      "default": 262144
    },
    {
      "id": 5,
      "name": "MAX_MANIFEST_PAGE_PAYLOAD",
      "min": 65536,
      "max": 1048576,
      "default": 1048576
    },
    {
      "id": 7,
      "name": "RELIABLE_LANE_LIMIT",
      "min": 1,
      "max": 256,
      "default": 16
    },
    {
      "id": 9,
      "name": "IDLE_TIMEOUT_MS",
      "min": 1000,
      "max": 600000,
      "default": 90000
    }
  ],
  "hello": [
    {
      "name": "client-no-extensions",
      "canonical_hex": "050000",
      "expected": {
        "result": "ok",
        "draft_revision": 5,
        "endpoint_role": 0,
        "extensions": []
      }
    },
    {
      "name": "client-three-extensions-ascending",
      "canonical_hex": "050003000206",
      "expected": {
        "result": "ok",
        "draft_revision": 5,
        "endpoint_role": 0,
        "extensions": [
          0,
          2,
          6
        ]
      }
    },
    {
      "name": "extension-identifier-needing-a-wider-varint",
      "canonical_hex": "0500014100",
      "expected": {
        "result": "ok",
        "draft_revision": 5,
        "endpoint_role": 0,
        "extensions": [
          256
        ]
      }
    },
    {
      "name": "the-largest-legal-extension-identifier",
      "canonical_hex": "050001ffffffffffffffff",
      "expected": {
        "result": "ok",
        "draft_revision": 5,
        "endpoint_role": 0,
        "extensions": [
          4611686018427387903
        ]
      }
    },
    {
      "name": "server-role-is-representable",
      "canonical_hex": "050100",
      "expected": {
        "result": "ok",
        "draft_revision": 5,
        "endpoint_role": 1,
        "extensions": []
      },
      "note": "The role is encodable, but spec/wire.md section 1 has only the client send HELLO, on the stream it opened. A server sending this would contradict the stream initiator."
    },
    {
      "name": "older-draft-rejected",
      "hex": "030000",
      "expected": {
        "result": "error",
        "error": "UNSUPPORTED_VERSION",
        "draft_revision": 3
      }
    },
    {
      "name": "newer-draft-rejected",
      "hex": "060000",
      "expected": {
        "result": "error",
        "error": "UNSUPPORTED_VERSION",
        "draft_revision": 6
      }
    },
    {
      "name": "role-out-of-range",
      "hex": "050200",
      "expected": {
        "result": "error",
        "error": "MALFORMED_FRAME"
      }
    },
    {
      "name": "duplicate-extension",
      "hex": "0500020303",
      "expected": {
        "result": "error",
        "error": "MALFORMED_FRAME"
      }
    },
    {
      "name": "extension-count-beyond-the-bound",
      "hex": "05004101",
      "expected": {
        "result": "error",
        "error": "RESOURCE_LIMIT",
        "extension_count": 257
      }
    },
    {
      "name": "truncated-inside-the-extension-list",
      "hex": "05000203",
      "expected": {
        "result": "error",
        "error": "MALFORMED_FRAME"
      }
    },
    {
      "name": "trailing-bytes-after-the-list",
      "hex": "05000100ff",
      "expected": {
        "result": "error",
        "error": "MALFORMED_FRAME"
      }
    },
    {
      "name": "non-minimal-revision-varint-is-accepted",
      "hex": "40050000",
      "expected": {
        "result": "ok",
        "draft_revision": 5,
        "endpoint_role": 0,
        "extensions": []
      },
      "note": "Encoders emit the shortest form, but spec/wire.md section 2 requires decoders to accept every legal QUIC representation."
    }
  ],
  "settings": [
    {
      "name": "every-registered-setting-at-its-default",
      "canonical_hex": "01801000000380040000058010000007100980015f90",
      "expected": {
        "result": "ok",
        "settings": {
          "1": 1048576,
          "3": 262144,
          "5": 1048576,
          "7": 16,
          "9": 90000
        }
      },
      "note": "Every registered setting is advertised rather than only those differing from a default, because the peer's defaults are its own."
    },
    {
      "name": "every-registered-setting-at-its-minimum",
      "canonical_hex": "0144000380010000058001000007010943e8",
      "expected": {
        "result": "ok",
        "settings": {
          "1": 1024,
          "3": 65536,
          "5": 65536,
          "7": 1,
          "9": 1000
        }
      }
    },
    {
      "name": "every-registered-setting-at-its-maximum",
      "canonical_hex": "01810000000380040000058010000007410009800927c0",
      "expected": {
        "result": "ok",
        "settings": {
          "1": 16777216,
          "3": 262144,
          "5": 1048576,
          "7": 256,
          "9": 600000
        }
      }
    },
    {
      "name": "empty-payload-leaves-every-default",
      "hex": "",
      "expected": {
        "result": "ok",
        "settings": {
          "1": 1048576,
          "3": 262144,
          "5": 1048576,
          "7": 16,
          "9": 90000
        }
      },
      "note": "A peer that advertises nothing is taken to mean the defaults, which is what lets a later revision add a setting without breaking this one."
    },
    {
      "name": "unknown-optional-setting-ignored",
      "hex": "410001",
      "expected": {
        "result": "ok",
        "settings": {
          "1": 1048576,
          "3": 262144,
          "5": 1048576,
          "7": 16,
          "9": 90000
        }
      },
      "note": "Identifier 256 is even, so unknown means ignore. Its value is still read, which is what keeps the pairs aligned."
    },
    {
      "name": "unknown-critical-setting-rejected",
      "hex": "410101",
      "expected": {
        "result": "error",
        "error": "INVALID_SETTING",
        "setting": 257
      }
    },
    {
      "name": "duplicate-setting-rejected",
      "hex": "07100710",
      "expected": {
        "result": "error",
        "error": "DUPLICATE_SETTING",
        "setting": 7
      }
    },
    {
      "name": "value-below-the-registered-range",
      "hex": "0143ff",
      "expected": {
        "result": "error",
        "error": "INVALID_SETTING",
        "setting": 1,
        "value": 1023
      }
    },
    {
      "name": "value-above-the-registered-range",
      "hex": "09800927c1",
      "expected": {
        "result": "error",
        "error": "INVALID_SETTING",
        "setting": 9,
        "value": 600001
      }
    },
    {
      "name": "retired-critical-setting-rejected",
      "hex": "0b80004e20",
      "expected": {
        "result": "error",
        "error": "INVALID_SETTING",
        "setting": 11
      },
      "note": "ADR-0035 retired 0x0b. It was critical, so a peer built against an earlier draft that still sends it closes the session rather than being quietly ignored."
    },
    {
      "name": "retired-optional-setting-ignored",
      "hex": "2201",
      "expected": {
        "result": "ok",
        "settings": {
          "1": 1048576,
          "3": 262144,
          "5": 1048576,
          "7": 16,
          "9": 90000
        }
      },
      "note": "ADR-0035 retired 0x22, which was optional, so it is ignored like any unknown optional setting."
    },
    {
      "name": "the-other-retired-optional-setting-is-ignored",
      "hex": "2041f4",
      "expected": {
        "result": "ok",
        "settings": {
          "1": 1048576,
          "3": 262144,
          "5": 1048576,
          "7": 16,
          "9": 90000
        }
      },
      "note": "0x20 was COMPRESSION_MIN_GAIN_BPS. All three retired identifiers get a vector, because an implementation validated only against these could otherwise reassign the one that has none, which spec/registries.md says MUST NOT happen."
    },
    {
      "name": "identifier-without-a-value",
      "hex": "01",
      "expected": {
        "result": "error",
        "error": "MALFORMED_FRAME"
      }
    }
  ]
}
